# .env: 仅保留敏感信息。其他运行配置请放在根目录 app.yaml 中。

# LLM_API_KEY: 通用 LLM 密钥。
LLM_API_KEY=your_llm_api_key_here

# LLM_BASE_URL: 通用 LLM 接口地址。
LLM_BASE_URL=https://api.openai.com/v1

# VISION_API_KEY: 独立视觉模型密钥。留空时复用 LLM_API_KEY。
VISION_API_KEY=

# VISION_BASE_URL: 独立视觉模型接口地址。留空时复用 LLM_BASE_URL。
VISION_BASE_URL=

# MCP_API_KEY: 全局 MCP 认证密钥兜底。未单独指定时会应用到所有 MCP 实例。
MCP_API_KEY=

# MCP_PLAYWRIGHT_API_KEY: Playwright MCP 专用认证密钥。配置后优先于 MCP_API_KEY。
MCP_PLAYWRIGHT_API_KEY=

# MCP_WINAPP_API_KEY: WinApp MCP 专用认证密钥。配置后优先于 MCP_API_KEY。
MCP_WINAPP_API_KEY=

# MCP_HYPIUM_API_KEY: Hypium MCP 专用认证密钥。配置后优先于 MCP_API_KEY。
MCP_HYPIUM_API_KEY=

# MCP_ANDROID_API_KEY: Android MCP 专用认证密钥。配置后优先于 MCP_API_KEY。
MCP_ANDROID_API_KEY=

# MCP_IOS_API_KEY: iOS MCP 专用认证密钥。配置后优先于 MCP_API_KEY。
MCP_IOS_API_KEY=
