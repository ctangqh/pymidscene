# 通用配置
DEBUG=true
LOG_LEVEL=INFO

# OpenAI 配置（必填）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 其他模型配置（可选）
# DOUBAN_API_KEY=xxx
# DOUBAN_BASE_URL=https://aquasearch.bytedance.com/api/v3

# 浏览器配置
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# 报告配置
REPORT_SAVE_DIR=./output/reports
REPORT_SCREENSHOT_SAVE_DIR=./output/screenshots
