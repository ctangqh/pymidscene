# WinAppDriver MCP Server (Go) Configuration
# Copy this file to dist/.env when running the built executable

# MCP Server listen address
MCP_HOST=0.0.0.0
MCP_PORT=55001

# WinAppDriver service address
WINAPPDRIVER_HOST=127.0.0.1
WINAPPDRIVER_PORT=4723

# WinAppDriver HTTP request timeout (seconds)
WINAPPDRIVER_HTTP_TIMEOUT=120

# Auto-start WinAppDriver service (true/false)
WINAPPDRIVER_AUTO_START=false
